# Copia este archivo como .env y completa los valores. NUNCA subas el .env.
# Las variables EXPO_PUBLIC_* viajan DENTRO de la app: solo valores públicos.
# Tras editar el .env, reinicia Expo con: npx expo start -c

# Project URL de Supabase (termina en .supabase.co, sin /rest/v1/)
EXPO_PUBLIC_SUPABASE_URL=
# Llave pública (anon / publishable). NUNCA la service_role.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# URL del backend FastAPI. Con teléfono físico usa la IP de tu computadora
# en la red wifi, por ejemplo http://192.168.1.50:8000 (NO localhost).
EXPO_PUBLIC_API_URL=

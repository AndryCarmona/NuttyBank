# Copia este archivo como .env y completa los valores. NUNCA subas el .env.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Solo para tareas administrativas del servidor. No la uses para consultar
# datos del usuario: usa su JWT para que se apliquen las políticas RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Para validar el JWT del usuario (según la configuración de firmado del proyecto)
SUPABASE_JWT_SECRET=

# --- Gemini (asistente Nutty) ---
# Se crea en Google AI Studio. Solo va aquí y en Render, NUNCA en la app móvil.
GEMINI_API_KEY=
# Opcional: si lo dejas vacío se usa gemini-3.5-flash-lite.
GEMINI_MODEL=

# --- Servidor ---
ALLOWED_ORIGINS=http://localhost:8081
